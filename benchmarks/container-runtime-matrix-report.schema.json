{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Container Runtime Matrix Report",
    "type": "object",
    "required": [
        "schemaVersion",
        "benchmarkName",
        "generatedAtUtc",
        "workloadFile",
        "loadTestWorkloadFile",
        "environment",
        "configuredLimits",
        "configuredLoadProfile",
        "runs"
    ],
    "properties": {
        "schemaVersion": {
            "const": 1
        },
        "benchmarkName": {
            "const": "container-runtime-matrix"
        },
        "generatedAtUtc": {
            "type": "string"
        },
        "workloadFile": {
            "type": "string"
        },
        "loadTestWorkloadFile": {
            "type": "string"
        },
        "environment": {
            "type": "object"
        },
        "configuredLimits": {
            "type": "object",
            "required": [
                "cpus",
                "memory",
                "pidsLimit",
                "jvmMaxRamPercentage"
            ],
            "properties": {
                "cpus": {
                    "type": "string"
                },
                "memory": {
                    "type": "string"
                },
                "pidsLimit": {
                    "type": "integer"
                },
                "jvmMaxRamPercentage": {
                    "type": "string"
                }
            }
        },
        "configuredLoadProfile": {
            "type": "object",
            "required": [
                "vus",
                "duration"
            ],
            "properties": {
                "vus": {
                    "type": "integer"
                },
                "duration": {
                    "type": "string"
                },
                "cases": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "enum": [
                            "post",
                            "get",
                            "mixed"
                        ]
                    }
                },
                "getSeedRows": {
                    "type": "integer"
                }
            }
        },
        "runs": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "scenario",
                    "runtime",
                    "mode",
                    "displayName",
                    "buildStrategy",
                    "image",
                    "buildDurationMs",
                    "startupDurationMs",
                    "containerObservation",
                    "loadTest"
                ],
                "properties": {
                    "scenario": {
                        "type": "string"
                    },
                    "runtime": {
                        "type": "string",
                        "enum": [
                            "spring",
                            "quarkus"
                        ]
                    },
                    "mode": {
                        "type": "string",
                        "enum": [
                            "jvm",
                            "native"
                        ]
                    },
                    "displayName": {
                        "type": "string"
                    },
                    "buildStrategy": {
                        "type": "object",
                        "required": [
                            "kind"
                        ],
                        "properties": {
                            "kind": {
                                "type": "string"
                            }
                        }
                    },
                    "image": {
                        "type": "object",
                        "required": [
                            "reference",
                            "sizeBytes"
                        ],
                        "properties": {
                            "reference": {
                                "type": "string"
                            },
                            "sizeBytes": {
                                "type": "integer"
                            }
                        }
                    },
                    "buildDurationMs": {
                        "type": "integer"
                    },
                    "startupDurationMs": {
                        "type": "integer"
                    },
                    "containerObservation": {
                        "type": "object",
                        "required": [
                            "memoryBytes",
                            "cpuPercent"
                        ],
                        "properties": {
                            "memoryBytes": {
                                "type": [
                                    "integer",
                                    "null"
                                ]
                            },
                            "cpuPercent": {
                                "type": [
                                    "number",
                                    "null"
                                ]
                            },
                            "startupMemoryBytes": {
                                "type": [
                                    "integer",
                                    "null"
                                ]
                            },
                            "startupCpuPercent": {
                                "type": [
                                    "number",
                                    "null"
                                ]
                            },
                            "postLoadMemoryBytes": {
                                "type": [
                                    "integer",
                                    "null"
                                ]
                            },
                            "postLoadCpuPercent": {
                                "type": [
                                    "number",
                                    "null"
                                ]
                            },
                            "sampledMemoryBytes": {
                                "type": [
                                    "integer",
                                    "null"
                                ]
                            },
                            "sampledCpuPercent": {
                                "type": [
                                    "number",
                                    "null"
                                ]
                            },
                            "sampledCpuMaxPercent": {
                                "type": [
                                    "number",
                                    "null"
                                ]
                            }
                        }
                    },
                    "loadTest": {
                        "type": "object",
                        "required": [
                            "outputDir",
                            "iterations",
                            "httpReqs",
                            "httpReqFailedRate",
                            "avgDurationMs",
                            "p95DurationMs"
                        ],
                        "properties": {
                            "outputDir": {
                                "type": "string"
                            },
                            "cases": {
                                "type": "object",
                                "minProperties": 1,
                                "additionalProperties": false,
                                "properties": {
                                    "post": {
                                        "$ref": "#/$defs/loadTestCase"
                                    },
                                    "get": {
                                        "$ref": "#/$defs/loadTestCase"
                                    },
                                    "mixed": {
                                        "$ref": "#/$defs/loadTestCase"
                                    }
                                }
                            },
                            "iterations": {
                                "type": "integer"
                            },
                            "httpReqs": {
                                "type": "integer"
                            },
                            "httpReqFailedRate": {
                                "type": "number"
                            },
                            "avgDurationMs": {
                                "type": [
                                    "number",
                                    "null"
                                ]
                            },
                            "p95DurationMs": {
                                "type": [
                                    "number",
                                    "null"
                                ]
                            },
                            "successfulAvgDurationMs": {
                                "type": [
                                    "number",
                                    "null"
                                ]
                            },
                            "successfulP95DurationMs": {
                                "type": [
                                    "number",
                                    "null"
                                ]
                            }
                        }
                    }
                }
            }
        }
    },
    "$defs": {
        "loadTestCase": {
            "type": "object",
            "required": [
                "iterations",
                "httpReqs",
                "httpReqFailedRate",
                "avgDurationMs",
                "p95DurationMs"
            ],
            "properties": {
                "outputDir": {
                    "type": "string"
                },
                "iterations": {
                    "type": "integer"
                },
                "httpReqs": {
                    "type": "integer"
                },
                "httpReqFailedRate": {
                    "type": [
                        "number",
                        "null"
                    ]
                },
                "avgDurationMs": {
                    "type": [
                        "number",
                        "null"
                    ]
                },
                "p95DurationMs": {
                    "type": [
                        "number",
                        "null"
                    ]
                },
                "successfulAvgDurationMs": {
                    "type": [
                        "number",
                        "null"
                    ]
                },
                "successfulP95DurationMs": {
                    "type": [
                        "number",
                        "null"
                    ]
                },
                "startupDurationMs": {
                    "type": "integer"
                },
                "startupLog": {
                    "type": "string"
                },
                "runtimeLog": {
                    "type": "string"
                },
                "summaryFile": {
                    "type": "string"
                },
                "logFile": {
                    "type": "string"
                },
                "containerObservation": {
                    "type": "object",
                    "properties": {
                        "statsFile": {
                            "type": "string"
                        },
                        "memoryBytes": {
                            "type": [
                                "integer",
                                "null"
                            ]
                        },
                        "cpuAvgPercent": {
                            "type": [
                                "number",
                                "null"
                            ]
                        },
                        "cpuMaxPercent": {
                            "type": [
                                "number",
                                "null"
                            ]
                        }
                    }
                }
            }
        }
    }
}
